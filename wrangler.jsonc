{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "equiflow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The xAI key is a secret, never a var. Set it with `wrangler secret put XAI_API_KEY`.
  // Local development reads it from .dev.vars. An empty or short value leaves analysis unconfigured.
  "secrets": {
    "required": ["XAI_API_KEY"]
  },
  // 8 analysis calls per 60 seconds, per key, per Cloudflare location.
  // The binding is approximate. See the README.
  "ratelimits": [
    {
      "name": "ANALYSIS_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "dev": {
    "port": 8787
  }
}
