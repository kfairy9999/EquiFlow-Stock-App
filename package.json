{
  "name": "equiflow",
  "version": "1.0.0",
  "private": true,
  "description": "A warm equity dashboard that simulates a live tape in the browser, computes an SMA-20 and volatility notes, and asks Gemini for a short read through a Cloudflare Worker.",
  "license": "MIT",
  "author": "Kevin",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"vite --host 0.0.0.0 --port 3000\" \"npm run dev:api\"",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "bash scripts/dev-api.sh",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "wrangler types && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.46.3",
    "vite": "^6.2.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.46.0"
  }
}
